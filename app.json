{
  "expo": {
    "name": "ProteIN",
    "slug": "protein-ai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B0F14",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/73a4b9f5-7f5f-4233-97d9-b3096f6259a4"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ProteIN uses your photos so you can pick a meal photo or a profile picture.",
          "cameraPermission": "ProteIN uses the camera to scan your meals and take your profile photo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4ADE80"
        }
      ],
      "expo-av",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/vazirmatn/300Light/Vazirmatn_300Light.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/400Regular/Vazirmatn_400Regular.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/500Medium/Vazirmatn_500Medium.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/600SemiBold/Vazirmatn_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/700Bold/Vazirmatn_700Bold.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/800ExtraBold/Vazirmatn_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/900Black/Vazirmatn_900Black.ttf"
          ]
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bb.protein",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ProteIN uses the camera to scan your meals and take your profile photo.",
        "NSPhotoLibraryUsageDescription": "ProteIN uses your photos so you can pick a meal photo or a profile picture.",
        "NSMicrophoneUsageDescription": "ProteIN uses the microphone so you can say what you ate.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bb.protein",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4ADE80"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "73a4b9f5-7f5f-4233-97d9-b3096f6259a4"
      }
    },
    "owner": "bahar.bahreman"
  }
}
